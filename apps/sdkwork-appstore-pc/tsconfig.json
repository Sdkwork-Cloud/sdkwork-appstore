{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@sdkwork/appstore-pc-core": [
        "./packages/sdkwork-appstore-pc-core/src/index.ts"
      ],
      "@sdkwork/appstore-pc-commons": [
        "./packages/sdkwork-appstore-pc-commons/src/index.ts"
      ],
      "@sdkwork/appstore-pc-shell": [
        "./packages/sdkwork-appstore-pc-shell/src/index.ts"
      ],
      "@sdkwork/appstore-pc-discover": [
        "./packages/sdkwork-appstore-pc-discover/src/index.ts"
      ],
      "@sdkwork/appstore-pc-apps": [
        "./packages/sdkwork-appstore-pc-apps/src/index.ts"
      ],
      "@sdkwork/appstore-pc-games": [
        "./packages/sdkwork-appstore-pc-games/src/index.ts"
      ],
      "@sdkwork/appstore-pc-ai-hub": [
        "./packages/sdkwork-appstore-pc-ai-hub/src/index.ts"
      ],
      "@sdkwork/appstore-pc-charts": [
        "./packages/sdkwork-appstore-pc-charts/src/index.ts"
      ],
      "@sdkwork/appstore-pc-search": [
        "./packages/sdkwork-appstore-pc-search/src/index.ts"
      ],
      "@sdkwork/appstore-pc-updates": [
        "./packages/sdkwork-appstore-pc-updates/src/index.ts"
      ],
      "@sdkwork/appstore-pc-app-detail": [
        "./packages/sdkwork-appstore-pc-app-detail/src/index.ts"
      ],
      "@sdkwork/appstore-pc-console-core": [
        "./packages/sdkwork-appstore-pc-console-core/src/index.ts"
      ],
      "@sdkwork/appstore-pc-console-shell": [
        "./packages/sdkwork-appstore-pc-console-shell/src/index.ts"
      ],
      "@sdkwork/appstore-pc-console-settings": [
        "./packages/sdkwork-appstore-pc-console-settings/src/index.ts"
      ],
      "@sdkwork/appstore-pc-admin-core": [
        "./packages/sdkwork-appstore-pc-admin-core/src/index.ts"
      ],
      "@sdkwork/appstore-pc-admin-shell": [
        "./packages/sdkwork-appstore-pc-admin-shell/src/index.ts"
      ],
      "@sdkwork/appstore-pc-admin-monitor": [
        "./packages/sdkwork-appstore-pc-admin-monitor/src/index.ts"
      ],
      "@sdkwork/appstore-pc-desktop": [
        "./packages/sdkwork-appstore-pc-desktop/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
